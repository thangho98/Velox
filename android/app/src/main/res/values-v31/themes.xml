<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Velox" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#141414</item>
        <item name="android:navigationBarColor">#141414</item>
        <item name="android:windowBackground">#141414</item>
        
        <!-- Android 12+ always shows a system starting window.
             Hide its default launcher icon so our Compose SplashScreen owns the logo. -->
        <item name="android:windowSplashScreenBackground">#000000</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#000000</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
