{
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "env-cmd concurrently --names \"backend,webapp\" --prefix-colors \"yellow,cyan\" \"pnpm run dev:backend\" \"pnpm run dev:webapp\"",
    "dev:backend": "cd backend && air",
    "dev:webapp": "cd webapp && pnpm run dev",
    "build": "concurrently --names \"backend,webapp\" --prefix-colors \"yellow,cyan\" \"pnpm run build:backend\" \"pnpm run build:webapp\"",
    "build:backend": "cd backend && pnpm run build",
    "build:webapp": "cd webapp && pnpm run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "env-cmd": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0"
  },
  "lint-staged": {
    "webapp/src/**/*.{ts,tsx}": [
      "webapp/node_modules/.bin/prettier --write --config webapp/.prettierrc"
    ],
    "backend/**/*.go": [
      "gofmt -w"
    ]
  }
}
